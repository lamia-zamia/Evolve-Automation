{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsc/architecture.tsbuildinfo",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true
  },
  "include": [
    "src/application/**/*.ts",
    "src/domain/**/*.ts",
    "src/ports/**/*.ts",
    "src/adapters/**/*.ts",
    "src/bootstrap/**/*.ts",
    "src/formatting/**/*.ts",
    "src/observability/**/*.ts",
    "src/planning/**/*.ts",
    "src/settings/**/*.ts",
    "src/ui/**/*.ts",
    "src/utils/**/*.ts",
    "src/validation/**/*.ts",
    "src/game/compatibility.ts",
    "src/game/entity-catalogs.ts",
    "src/game/script-bootstrap.ts",
    "src/game/trait-value.ts",
    "src/game/planet-generation.ts",
    "src/game/foreign-government.ts",
    "src/game/infrastructure-managers.ts",
    "src/game/script-data.ts",
    "src/game/trait-managers.ts",
    "src/game/industry-managers.ts",
    "src/game/magic-managers.ts",
    "src/game/mech-manager.ts",
    "src/game/fleet-managers.ts",
    "src/game/race-initialization.ts",
    "src/game/building-state.ts",
    "src/game/runtime-queries.ts",
    "src/game/rates.ts",
    "src/config.ts",
    "src/main.ts"
  ]
}
