{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsc/architecture.tsbuildinfo",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true
  },
  "include": [
    "src/application/**/*.ts",
    "src/domain/**/*.ts",
    "src/ports/**/*.ts",
    "src/adapters/**/*.ts",
    "src/bootstrap/**/*.ts",
    "src/formatting/**/*.ts",
    "src/observability/**/*.ts",
    "src/planning/**/*.ts",
    "src/settings/**/*.ts",
    "src/ui/**/*.ts",
    "src/utils/**/*.ts",
    "src/validation/**/*.ts",
    "src/game/compatibility.ts",
    "src/game/entity-catalogs.ts",
    "src/game/script-bootstrap.ts",
    "src/config.ts",
    "src/main.ts"
  ]
}
