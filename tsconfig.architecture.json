{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true
  },
  "include": [
    "src/application/**/*.ts",
    "src/domain/**/*.ts",
    "src/ports/**/*.ts",
    "src/adapters/**/*.ts",
    "src/bootstrap/**/*.ts",
    "src/formatting/**/*.ts",
    "src/observability/**/*.ts",
    "src/planning/**/*.ts",
    "src/policies/**/*.ts",
    "src/utils/**/*.ts",
    "src/validation/**/*.ts",
    "src/config.ts",
    "src/main.ts"
  ]
}
