{
  "name": "evolve-automation",
  "version": "3.3.2-1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node scripts/test.mjs",
    "dev": "node build.mjs --watch",
    "prepare": "node scripts/setup-hooks.mjs",
    "verify": "npm run build && npm run check && git diff --exit-code -- evolve_automation.user.js evolve_automation.meta.js"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
