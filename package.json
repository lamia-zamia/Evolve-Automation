{
  "name": "evolve-automation",
  "version": "3.3.2-1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:check": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run typecheck && npm run lint:check && npm run format:check && node scripts/test.mjs",
    "dev": "node build.mjs --watch",
    "prepare": "node scripts/setup-hooks.mjs",
    "verify": "npm run build && npm run check && git diff --exit-code -- evolve_automation.user.js evolve_automation.meta.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
