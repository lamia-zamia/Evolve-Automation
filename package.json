{
  "name": "evolve-automation",
  "version": "3.3.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:local": "node build.mjs --local",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck:architecture",
    "typecheck:architecture": "tsc -p tsconfig.architecture.json",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:check": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier . --write --cache",
    "format:check": "prettier . --check --cache",
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs",
    "check:serial": "npm run typecheck && npm run lint:check && npm run format:check && node scripts/test.mjs",
    "dev": "node build.mjs --watch",
    "dev:local": "node build.mjs --local --watch",
    "version": "node scripts/update-version.mjs",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "release:major": "npm version major --no-git-tag-version",
    "prepare": "node scripts/setup-hooks.mjs",
    "verify": "npm run build && npm run check && git diff --exit-code -- evolve_automation.user.js evolve_automation.meta.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
